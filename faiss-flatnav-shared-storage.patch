--- /dev/null
+++ b/demos/demo_paired_nsg_flatnav_same_storage_parallel.cpp
@@ -0,0 +1,239 @@
+// ============================================================
+// demo_paired_nsg_flatnav_same_storage_parallel.cpp
+//
+// NSG (faiss) + FlatNav built in parallel on ONE shared
+// faiss::IndexFlatL2. The vectors exist exactly once:
+//
+//   shared_storage (IndexFlatL2)  <- the only copy of the vectors
+//     ^                    ^
+//     |                    |
+//   faiss::IndexNSG      FlatNav (graph only: M links + label per node,
+//   (&shared_storage)     distances read from shared_storage.codes)
+//
+// Node / vector id i is the same in both indexes, so results can be
+// compared or paired directly.
+//
+// Each build runs on its own pinned CPU with exactly one thread.
+// FlatNav and faiss are both compiled for AVX2 (no AVX-512); the
+// SIMD configuration is printed and logged at startup.
+//
+// Usage:
+//   demo_paired_nsg_flatnav_same_storage_parallel
+//       base.fvecs query.fvecs [gt.ivecs|-] [log.csv]
+//       [NSG_R=32] [NSG_search_L=64]
+//       [FLATNAV_M=32] [FLATNAV_efConstruction=100] [FLATNAV_efSearch=64]
+// ============================================================
+
+#include "paired_flatnav_common.hpp"
+
+int main(int argc, char** argv) {
+    if (argc < 3) {
+        std::cerr << "Usage:\n  " << argv[0]
+                  << " base.fvecs query.fvecs [gt.ivecs|-] [log.csv]"
+                  << " [NSG_R] [NSG_search_L]"
+                  << " [FLATNAV_M] [FLATNAV_efC] [FLATNAV_efS]\n";
+        return 1;
+    }
+    const char* base_file = argv[1];
+    const char* query_file = argv[2];
+    const char* gt_file = (argc >= 4) ? argv[3] : nullptr;
+    const std::string log_path = (argc >= 5) ? argv[4] : "benchmark_log.csv";
+    log_init(log_path);
+
+    // ========================================================
+    // Parameters
+    // ========================================================
+    const int NSG_R = (argc >= 6) ? stoi(argv[5]) : 32;
+    const int NSG_SEARCH_L = (argc >= 7) ? stoi(argv[6]) : 64;
+    const int NSG_GK = 64;  // kNN-graph degree for NSG's brute-force build (as in the HNSW+NSG demos)
+    const int FLATNAV_M = (argc >= 8) ? stoi(argv[7]) : 32;
+    const int FLATNAV_EF_CONSTRUCTION = (argc >= 9) ? stoi(argv[8]) : 100;
+    const int FLATNAV_EF_SEARCH = (argc >= 10) ? stoi(argv[9]) : 64;
+    const faiss::idx_t K = 20;
+    const size_t RECALL_EVAL_K = 20;
+
+    std::cout << "\n========================================\n"
+              << "Paired NSG + FlatNav Demo (same storage)\n"
+              << "========================================\n"
+              << "NSG R                  = " << NSG_R << "\n"
+              << "NSG GK                 = " << NSG_GK << "\n"
+              << "NSG search_L           = " << NSG_SEARCH_L << "\n"
+              << "FlatNav M              = " << FLATNAV_M << "\n"
+              << "FlatNav efConstruction = " << FLATNAV_EF_CONSTRUCTION << "\n"
+              << "FlatNav efSearch       = " << FLATNAV_EF_SEARCH << "\n";
+    log_metric("params", "nsg_R", NSG_R);
+    log_metric("params", "nsg_GK", NSG_GK);
+    log_metric("params", "nsg_search_L", NSG_SEARCH_L);
+    log_metric("params", "flatnav_M", FLATNAV_M);
+    log_metric("params", "flatnav_ef_construction", FLATNAV_EF_CONSTRUCTION);
+    log_metric("params", "flatnav_ef_search", FLATNAV_EF_SEARCH);
+
+    report_simd_config();
+
+    PairDataset ds;
+    if (!load_pair_dataset(base_file, query_file, gt_file, RECALL_EVAL_K, ds)) {
+        return 1;
+    }
+    const int d = ds.d;
+    const faiss::idx_t n = ds.n;
+
+    // ========================================================
+    // Populate ONE shared storage, once
+    // ========================================================
+    std::cout << "\n========================================\n"
+              << "Populating shared storage\n"
+              << "========================================\n";
+    faiss::IndexFlatL2 shared_storage(d);
+    shared_storage.add(n, ds.xb);
+    std::cout << "shared_storage.ntotal = " << shared_storage.ntotal << "\n";
+
+    // ========================================================
+    // Construct both indexes directly on the shared storage
+    // ========================================================
+    // Index*-taking ctor: own_fields = false, NSG never adds to or
+    // frees shared_storage. That ctor defaults build_type to 1
+    // (NNDescent); force brute force (0) to match
+    // build_nsg_graph_on_shared_storage, which only ports that path.
+    faiss::IndexNSG nsg(&shared_storage, NSG_R);
+    nsg.GK = NSG_GK;
+    nsg.build_type = 0;
+    nsg.nsg.search_L = NSG_SEARCH_L;
+    PAIR_CHECK(!nsg.own_fields);
+
+    // FlatNav reads shared_storage.codes directly (no copy).
+    auto flatnav_index = flatnav_faiss::make_flatnav_l2(shared_storage, FLATNAV_M);
+    PAIR_CHECK(flatnav_index->usesExternalStorage());
+
+    // ========================================================
+    // Build both graphs in parallel, one pinned thread each
+    // ========================================================
+    std::cout << "\n========================================\n"
+              << "Building NSG + FlatNav in parallel on shared storage\n"
+              << "========================================\n";
+    const int total_threads = available_cpu_count();
+    const std::pair<int, int> build_cpus = pick_two_cpus();
+    const int cpu_for_nsg = build_cpus.first;
+    const int cpu_for_flatnav = build_cpus.second;
+    std::cout << "NSG thread -> CPU " << cpu_for_nsg << ", FlatNav thread -> CPU "
+              << cpu_for_flatnav << "\n";
+
+    PinnedBuild nsg_build, flatnav_build;
+    double parallel_build_wall_seconds = time_seconds([&]() {
+        std::thread nsg_thread = start_pinned_build(cpu_for_nsg, nsg_build, [&]() {
+            build_nsg_graph_on_shared_storage(
+                    nsg, static_cast<size_t>(n), ds.xb, /*verbose=*/false);
+        });
+        std::thread flatnav_thread = start_pinned_build(cpu_for_flatnav, flatnav_build, [&]() {
+            flatnav_faiss::build(*flatnav_index, FLATNAV_EF_CONSTRUCTION, /*num_threads=*/1);
+        });
+        nsg_thread.join();
+        flatnav_thread.join();
+    });
+
+    std::cout << "NSG     build: " << nsg_build.seconds << " sec on CPU " << nsg_build.ran_on_cpu
+              << " (pinned to " << nsg_build.requested_cpu << "), ntotal = " << nsg.ntotal << "\n"
+              << "FlatNav build: " << flatnav_build.seconds << " sec on CPU "
+              << flatnav_build.ran_on_cpu << " (pinned to " << flatnav_build.requested_cpu
+              << "), nodes = " << flatnav_index->currentNumNodes() << "\n"
+              << "Combined wall-clock time = " << parallel_build_wall_seconds << " sec (vs. "
+              << (nsg_build.seconds + flatnav_build.seconds) << " sec if run sequentially)\n";
+    log_metric("construction", "nsg_build_seconds", nsg_build.seconds);
+    log_metric("construction", "flatnav_build_seconds", flatnav_build.seconds);
+    log_metric("construction", "parallel_build_wall_seconds", parallel_build_wall_seconds);
+
+    // ========================================================
+    // Verify the storage really was shared
+    // ========================================================
+    std::cout << "\n========================================\n"
+              << "Verifying shared storage\n"
+              << "========================================\n"
+              << "shared_storage address      = " << static_cast<void*>(&shared_storage) << "\n"
+              << "nsg.storage                = " << static_cast<void*>(nsg.storage) << "\n"
+              << "shared_storage.get_xb()     = "
+              << static_cast<const void*>(shared_storage.get_xb()) << "\n"
+              << "FlatNav vector pointer      = " << flatnav_index->externalStorageData() << "\n";
+    PAIR_CHECK(nsg.storage == &shared_storage);
+    PAIR_CHECK(!nsg.own_fields);
+    PAIR_CHECK(flatnav_index->externalStorageData() ==
+               static_cast<const void*>(shared_storage.get_xb()));
+    PAIR_CHECK(shared_storage.ntotal == n);
+    PAIR_CHECK(nsg.ntotal == n);
+    PAIR_CHECK(flatnav_index->currentNumNodes() == static_cast<size_t>(n));
+    std::cout << "\nSUCCESS: NSG and FlatNav were built in parallel directly on one "
+              << "shared storage instance — no vectors were ever duplicated.\n";
+
+    // ========================================================
+    // Index sizes
+    // ========================================================
+    const size_t storage_bytes = flat_storage_bytes_direct(shared_storage);
+    const size_t nsg_graph = nsg_graph_bytes_direct(nsg.nsg);
+    const size_t flatnav_graph = flatnav_faiss::graph_overhead_bytes(*flatnav_index);
+    const size_t combined = storage_bytes + nsg_graph + flatnav_graph;
+    const size_t unshared = 2 * storage_bytes + nsg_graph + flatnav_graph;
+    std::cout << "\n========================================\n"
+              << "Index size breakdown\n"
+              << "========================================\n"
+              << "  Shared vector storage   : " << to_mb(storage_bytes) << " MB\n"
+              << "  NSG graph overhead     : " << to_mb(nsg_graph) << " MB\n"
+              << "  FlatNav graph overhead  : " << to_mb(flatnav_graph) << " MB\n"
+              << "  Combined (storage x1)   : " << to_mb(combined) << " MB\n"
+              << "  If not shared           : " << to_mb(unshared) << " MB (saved "
+              << to_mb(unshared - combined) << " MB)\n"
+              << "  Current RSS             : " << to_mb(get_current_rss_bytes()) << " MB\n";
+    log_metric("index_size", "storage_bytes", static_cast<double>(storage_bytes));
+    log_metric("index_size", "nsg_graph_overhead_bytes", static_cast<double>(nsg_graph));
+    log_metric("index_size", "flatnav_graph_overhead_bytes", static_cast<double>(flatnav_graph));
+    log_metric("index_size", "combined_bytes", static_cast<double>(combined));
+
+    // ========================================================
+    // Query phase (full parallelism, same thread count for both)
+    // ========================================================
+    std::cout << "\n========================================\n"
+              << "Query phase (nq = " << ds.nq << ", k = " << K << ", threads = "
+              << total_threads << ")\n"
+              << "========================================\n";
+    omp_set_num_threads(total_threads);
+    const size_t nk = static_cast<size_t>(ds.nq) * static_cast<size_t>(K);
+
+    std::vector<float> nsg_distances(nk);
+    std::vector<faiss::idx_t> nsg_labels(nk);
+    double nsg_seconds = time_seconds([&]() {
+        nsg.search(ds.nq, ds.xq, K, nsg_distances.data(), nsg_labels.data());
+    });
+    QueryReport nsg_q = report_query("nsg", nsg_seconds, nsg_labels, K, ds, RECALL_EVAL_K);
+
+    std::vector<float> flatnav_distances(nk);
+    std::vector<faiss::idx_t> flatnav_labels(nk);
+    double flatnav_seconds = time_seconds([&]() {
+        flatnav_faiss::search(
+                *flatnav_index,
+                ds.nq,
+                ds.xq,
+                static_cast<int>(K),
+                FLATNAV_EF_SEARCH,
+                flatnav_distances.data(),
+                flatnav_labels.data(),
+                /*num_threads=*/total_threads);
+    });
+    QueryReport flatnav_q =
+            report_query("flatnav", flatnav_seconds, flatnav_labels, K, ds, RECALL_EVAL_K);
+
+    // ========================================================
+    // Summary
+    // ========================================================
+    std::cout << "\n========================================\n"
+              << "Summary (same storage)\n"
+              << "========================================\n"
+              << "NSG     build = " << nsg_build.seconds << " s, QPS = " << nsg_q.qps
+              << ", recall@" << RECALL_EVAL_K << " = " << nsg_q.recall << "\n"
+              << "FlatNav build = " << flatnav_build.seconds << " s, QPS = " << flatnav_q.qps
+              << ", recall@" << RECALL_EVAL_K << " = " << flatnav_q.recall << "\n"
+              << "Parallel build wall time = " << parallel_build_wall_seconds << " s\n"
+              << "Total memory (storage x1) = " << to_mb(combined) << " MB\n";
+
+    if (g_log_file.is_open()) {
+        g_log_file.close();
+    }
+    std::cout << "\nDone\n";
+    return 0;
+}
diff --git a/demos/demo_paired_nsg_flatnav_separate_storage_parallel.cpp b/demos/demo_paired_nsg_flatnav_separate_storage_parallel.cpp
new file mode 100644
index 00000000..b5258f3d
--- /dev/null
+++ b/demos/demo_paired_nsg_flatnav_separate_storage_parallel.cpp
@@ -0,0 +1,235 @@
+// ============================================================
+// demo_paired_nsg_flatnav_separate_storage_parallel.cpp
+//
+// NSG (faiss) + FlatNav built in parallel, each with its OWN copy of
+// the vectors (the baseline for the same-storage demo):
+//
+//   faiss::IndexNSGFlat   -> own IndexFlatL2 (own_fields = true)
+//   FlatNav (owned)       -> own interleaved [vector][M links][label] nodes
+//
+// Both are filled from the same xb in the same order, so id i is the
+// same vector in both indexes.
+//
+// Each build runs on its own pinned CPU with exactly one thread.
+// FlatNav and faiss are both compiled for AVX2 (no AVX-512); the
+// SIMD configuration is printed and logged at startup.
+//
+// Usage:
+//   demo_paired_nsg_flatnav_separate_storage_parallel
+//       base.fvecs query.fvecs [gt.ivecs|-] [log.csv]
+//       [NSG_R=32] [NSG_search_L=64]
+//       [FLATNAV_M=32] [FLATNAV_efConstruction=100] [FLATNAV_efSearch=64]
+// ============================================================
+
+#include "paired_flatnav_common.hpp"
+
+int main(int argc, char** argv) {
+    if (argc < 3) {
+        std::cerr << "Usage:\n  " << argv[0]
+                  << " base.fvecs query.fvecs [gt.ivecs|-] [log.csv]"
+                  << " [NSG_R] [NSG_search_L]"
+                  << " [FLATNAV_M] [FLATNAV_efC] [FLATNAV_efS]\n";
+        return 1;
+    }
+    const char* base_file = argv[1];
+    const char* query_file = argv[2];
+    const char* gt_file = (argc >= 4) ? argv[3] : nullptr;
+    const std::string log_path = (argc >= 5) ? argv[4] : "benchmark_log.csv";
+    log_init(log_path);
+
+    // ========================================================
+    // Parameters
+    // ========================================================
+    const int NSG_R = (argc >= 6) ? stoi(argv[5]) : 32;
+    const int NSG_SEARCH_L = (argc >= 7) ? stoi(argv[6]) : 64;
+    const int NSG_GK = 64;  // kNN-graph degree for NSG's brute-force build (as in the HNSW+NSG demos)
+    const int FLATNAV_M = (argc >= 8) ? stoi(argv[7]) : 32;
+    const int FLATNAV_EF_CONSTRUCTION = (argc >= 9) ? stoi(argv[8]) : 100;
+    const int FLATNAV_EF_SEARCH = (argc >= 10) ? stoi(argv[9]) : 64;
+    const faiss::idx_t K = 20;
+    const size_t RECALL_EVAL_K = 20;
+
+    std::cout << "\n========================================\n"
+              << "Paired NSG + FlatNav Demo (separate storage)\n"
+              << "========================================\n"
+              << "NSG R                  = " << NSG_R << "\n"
+              << "NSG GK                 = " << NSG_GK << "\n"
+              << "NSG search_L           = " << NSG_SEARCH_L << "\n"
+              << "FlatNav M              = " << FLATNAV_M << "\n"
+              << "FlatNav efConstruction = " << FLATNAV_EF_CONSTRUCTION << "\n"
+              << "FlatNav efSearch       = " << FLATNAV_EF_SEARCH << "\n";
+    log_metric("params", "nsg_R", NSG_R);
+    log_metric("params", "nsg_GK", NSG_GK);
+    log_metric("params", "nsg_search_L", NSG_SEARCH_L);
+    log_metric("params", "flatnav_M", FLATNAV_M);
+    log_metric("params", "flatnav_ef_construction", FLATNAV_EF_CONSTRUCTION);
+    log_metric("params", "flatnav_ef_search", FLATNAV_EF_SEARCH);
+
+    report_simd_config();
+
+    PairDataset ds;
+    if (!load_pair_dataset(base_file, query_file, gt_file, RECALL_EVAL_K, ds)) {
+        return 1;
+    }
+    const int d = ds.d;
+    const faiss::idx_t n = ds.n;
+
+    // ========================================================
+    // Construct both indexes with SEPARATE, independent storage
+    // ========================================================
+    // IndexNSGFlat creates and owns its IndexFlatL2 (own_fields = true);
+    // nsg.add() below fills it and builds the graph, as stock faiss does.
+    // build_type = 0: brute-force kNN graph, same as the shared version.
+    faiss::IndexNSGFlat nsg(d, NSG_R, faiss::METRIC_L2);
+    nsg.GK = NSG_GK;
+    nsg.build_type = 0;
+    nsg.nsg.search_L = NSG_SEARCH_L;
+    PAIR_CHECK(nsg.own_fields);
+
+    // Regular FlatNav index: copies the vectors into its own node blocks.
+    auto flatnav_index = flatnav_faiss::make_flatnav_l2_owned(d, static_cast<size_t>(n), FLATNAV_M);
+    PAIR_CHECK(!flatnav_index->usesExternalStorage());
+
+    // ========================================================
+    // Build both graphs in parallel, one pinned thread each
+    // ========================================================
+    std::cout << "\n========================================\n"
+              << "Building NSG + FlatNav in parallel (separate storage)\n"
+              << "========================================\n";
+    const int total_threads = available_cpu_count();
+    const std::pair<int, int> build_cpus = pick_two_cpus();
+    const int cpu_for_nsg = build_cpus.first;
+    const int cpu_for_flatnav = build_cpus.second;
+    std::cout << "NSG thread -> CPU " << cpu_for_nsg << ", FlatNav thread -> CPU "
+              << cpu_for_flatnav << "\n";
+
+    PinnedBuild nsg_build, flatnav_build;
+    double parallel_build_wall_seconds = time_seconds([&]() {
+        std::thread nsg_thread = start_pinned_build(cpu_for_nsg, nsg_build, [&]() {
+            // Standard API: fills nsg's own storage AND builds the graph.
+            nsg.add(n, ds.xb);
+        });
+        std::thread flatnav_thread = start_pinned_build(cpu_for_flatnav, flatnav_build, [&]() {
+            // Copies xb into FlatNav's own memory and builds the graph.
+            flatnav_faiss::build_owned(
+                    *flatnav_index, ds.xb, static_cast<size_t>(n), FLATNAV_EF_CONSTRUCTION,
+                    /*num_threads=*/1);
+        });
+        nsg_thread.join();
+        flatnav_thread.join();
+    });
+
+    std::cout << "NSG     build: " << nsg_build.seconds << " sec on CPU " << nsg_build.ran_on_cpu
+              << " (pinned to " << nsg_build.requested_cpu << "), ntotal = " << nsg.ntotal << "\n"
+              << "FlatNav build: " << flatnav_build.seconds << " sec on CPU "
+              << flatnav_build.ran_on_cpu << " (pinned to " << flatnav_build.requested_cpu
+              << "), nodes = " << flatnav_index->currentNumNodes() << "\n"
+              << "Combined wall-clock time = " << parallel_build_wall_seconds << " sec (vs. "
+              << (nsg_build.seconds + flatnav_build.seconds) << " sec if run sequentially)\n";
+    log_metric("construction", "nsg_build_seconds", nsg_build.seconds);
+    log_metric("construction", "flatnav_build_seconds", flatnav_build.seconds);
+    log_metric("construction", "parallel_build_wall_seconds", parallel_build_wall_seconds);
+
+    // ========================================================
+    // Verify the storage really is separate
+    // ========================================================
+    const auto* nsg_flat = dynamic_cast<const faiss::IndexFlat*>(nsg.storage);
+    PAIR_CHECK(nsg_flat != nullptr);
+    std::cout << "\n========================================\n"
+              << "Verifying independent vector storage\n"
+              << "========================================\n"
+              << "nsg.storage                = " << static_cast<const void*>(nsg.storage) << "\n"
+              << "nsg.storage->get_xb()      = " << static_cast<const void*>(nsg_flat->get_xb())
+              << "\n"
+              << "FlatNav                     = owns its vectors ("
+              << flatnav_index->nodeSizeBytes() << " B/node incl. "
+              << flatnav_index->dataSizeBytes() << " B vector)\n";
+    PAIR_CHECK(nsg.own_fields);
+    PAIR_CHECK(nsg.storage->ntotal == n);
+    PAIR_CHECK(nsg.ntotal == n);
+    PAIR_CHECK(!flatnav_index->usesExternalStorage());
+    PAIR_CHECK(flatnav_index->externalStorageData() == nullptr);
+    PAIR_CHECK(flatnav_index->currentNumNodes() == static_cast<size_t>(n));
+    std::cout << "\nSUCCESS: NSG and FlatNav were built in parallel, each on its own "
+              << "separate, independent vector storage.\n";
+
+    // ========================================================
+    // Index sizes (storage_bytes = both vector copies)
+    // ========================================================
+    const size_t nsg_storage_bytes = flat_storage_bytes_direct(*nsg_flat);
+    const size_t flatnav_vector_bytes = flatnav_faiss::vector_bytes(*flatnav_index);
+    const size_t storage_bytes = nsg_storage_bytes + flatnav_vector_bytes;
+    const size_t nsg_graph = nsg_graph_bytes_direct(nsg.nsg);
+    const size_t flatnav_graph = flatnav_faiss::graph_overhead_bytes(*flatnav_index);
+    const size_t combined = storage_bytes + nsg_graph + flatnav_graph;
+    const size_t if_shared = nsg_storage_bytes + nsg_graph + flatnav_graph;
+    std::cout << "\n========================================\n"
+              << "Index size breakdown\n"
+              << "========================================\n"
+              << "  NSG vector storage     : " << to_mb(nsg_storage_bytes) << " MB\n"
+              << "  FlatNav vector copy     : " << to_mb(flatnav_vector_bytes) << " MB\n"
+              << "  NSG graph overhead     : " << to_mb(nsg_graph) << " MB\n"
+              << "  FlatNav graph overhead  : " << to_mb(flatnav_graph) << " MB\n"
+              << "  Combined (storage x2)   : " << to_mb(combined) << " MB\n"
+              << "  If shared               : " << to_mb(if_shared) << " MB (would save "
+              << to_mb(combined - if_shared) << " MB)\n"
+              << "  Current RSS             : " << to_mb(get_current_rss_bytes()) << " MB\n";
+    log_metric("index_size", "storage_bytes", static_cast<double>(storage_bytes));
+    log_metric("index_size", "nsg_storage_bytes", static_cast<double>(nsg_storage_bytes));
+    log_metric("index_size", "flatnav_vector_bytes", static_cast<double>(flatnav_vector_bytes));
+    log_metric("index_size", "nsg_graph_overhead_bytes", static_cast<double>(nsg_graph));
+    log_metric("index_size", "flatnav_graph_overhead_bytes", static_cast<double>(flatnav_graph));
+    log_metric("index_size", "combined_bytes", static_cast<double>(combined));
+
+    // ========================================================
+    // Query phase (full parallelism, same thread count for both)
+    // ========================================================
+    std::cout << "\n========================================\n"
+              << "Query phase (nq = " << ds.nq << ", k = " << K << ", threads = "
+              << total_threads << ")\n"
+              << "========================================\n";
+    omp_set_num_threads(total_threads);
+    const size_t nk = static_cast<size_t>(ds.nq) * static_cast<size_t>(K);
+
+    std::vector<float> nsg_distances(nk);
+    std::vector<faiss::idx_t> nsg_labels(nk);
+    double nsg_seconds = time_seconds([&]() {
+        nsg.search(ds.nq, ds.xq, K, nsg_distances.data(), nsg_labels.data());
+    });
+    QueryReport nsg_q = report_query("nsg", nsg_seconds, nsg_labels, K, ds, RECALL_EVAL_K);
+
+    std::vector<float> flatnav_distances(nk);
+    std::vector<faiss::idx_t> flatnav_labels(nk);
+    double flatnav_seconds = time_seconds([&]() {
+        flatnav_faiss::search(
+                *flatnav_index,
+                ds.nq,
+                ds.xq,
+                static_cast<int>(K),
+                FLATNAV_EF_SEARCH,
+                flatnav_distances.data(),
+                flatnav_labels.data(),
+                /*num_threads=*/total_threads);
+    });
+    QueryReport flatnav_q =
+            report_query("flatnav", flatnav_seconds, flatnav_labels, K, ds, RECALL_EVAL_K);
+
+    // ========================================================
+    // Summary
+    // ========================================================
+    std::cout << "\n========================================\n"
+              << "Summary (separate storage)\n"
+              << "========================================\n"
+              << "NSG     build = " << nsg_build.seconds << " s, QPS = " << nsg_q.qps
+              << ", recall@" << RECALL_EVAL_K << " = " << nsg_q.recall << "\n"
+              << "FlatNav build = " << flatnav_build.seconds << " s, QPS = " << flatnav_q.qps
+              << ", recall@" << RECALL_EVAL_K << " = " << flatnav_q.recall << "\n"
+              << "Parallel build wall time = " << parallel_build_wall_seconds << " s\n"
+              << "Total memory (storage x2) = " << to_mb(combined) << " MB\n";
+
+    if (g_log_file.is_open()) {
+        g_log_file.close();
+    }
+    std::cout << "\nDone\n";
+    return 0;
+}
diff --git a/demos/flatnav_faiss_storage.hpp b/demos/flatnav_faiss_storage.hpp
new file mode 100644
index 00000000..c79a985b
--- /dev/null
+++ b/demos/flatnav_faiss_storage.hpp
@@ -0,0 +1,228 @@
+#pragma once
+// ============================================================
+// flatnav_faiss_storage.hpp
+//
+// Glue that lets a FlatNav graph use a faiss::IndexFlat as its vector
+// storage (shared storage). FlatNav allocates only its graph
+// ([M links][label] per node); every distance reads the vector
+// straight out of faiss' `codes` buffer (IndexFlat::get_xb()).
+//
+// Node id i in FlatNav == row i in the faiss storage == faiss id i,
+// so FlatNav, IndexHNSW(&storage) and IndexNSG(&storage) all agree on
+// ids and can be compared / paired directly.
+//
+// Requirements
+//   * FlatNav with ExternalVectorStorage support (flatnav branch
+//     `faiss-shared-storage`, include/flatnav/index/Index.h).
+//   * SIMD: the demos build FlatNav with AVX2 (no AVX-512) by default;
+//     see FLATNAV_SIMD in demos/CMakeLists.txt.
+//   * storage is float32 IndexFlatL2 (-> FlatNav L2) or IndexFlatIP
+//     (-> FlatNav inner product). Scalar-quantized FlatNav cannot share
+//     because its internal vector format differs from faiss'.
+//   * Populate the storage before building, and don't call
+//     storage.add() while FlatNav is reading it (std::vector growth
+//     can move the buffer). If you do grow it, call
+//     reattach(index, storage) before the next build/search.
+// ============================================================
+
+#include <faiss/IndexFlat.h>
+#include <faiss/MetricType.h>
+#include <faiss/impl/FaissAssert.h>
+
+#include <flatnav/distances/InnerProductDistance.h>
+#include <flatnav/distances/SquaredL2Distance.h>
+#include <flatnav/index/Index.h>
+#include <flatnav/util/Multithreading.h>
+
+#include <algorithm>
+#include <cstdint>
+#include <memory>
+#include <numeric>
+#include <stdexcept>
+#include <vector>
+
+namespace flatnav_faiss {
+
+using flatnav::util::DataType;
+using L2Distance = flatnav::distances::SquaredL2Distance<DataType::float32>;
+using IPDistance = flatnav::distances::InnerProductDistance<DataType::float32>;
+
+// int labels: label i == faiss id i (fine up to 2^31 - 1 vectors).
+using FlatNavL2 = flatnav::Index<L2Distance, int>;
+using FlatNavIP = flatnav::Index<IPDistance, int>;
+
+// View of a faiss IndexFlat's vectors as FlatNav external storage.
+inline flatnav::ExternalVectorStorage storage_view(const faiss::IndexFlat& storage) {
+    return flatnav::ExternalVectorStorage{
+            /* data = */ storage.get_xb(),
+            /* num_vectors = */ static_cast<size_t>(storage.ntotal),
+            /* row_stride_bytes = */ static_cast<size_t>(storage.d) * sizeof(float)};
+}
+
+// Empty FlatNav L2 graph whose vectors are `storage` (an IndexFlatL2).
+// max_nodes = 0 -> storage.ntotal.
+inline std::unique_ptr<FlatNavL2> make_flatnav_l2(
+        const faiss::IndexFlat& storage,
+        int M,
+        size_t max_nodes = 0,
+        bool collect_stats = false) {
+    FAISS_THROW_IF_NOT_MSG(
+            storage.metric_type == faiss::METRIC_L2,
+            "make_flatnav_l2: storage must be an IndexFlatL2");
+    FAISS_THROW_IF_NOT_MSG(storage.ntotal > 0, "storage is empty: add vectors first");
+    return std::make_unique<FlatNavL2>(
+            L2Distance::create(storage.d),
+            static_cast<int>(max_nodes ? max_nodes : storage.ntotal),
+            M,
+            storage_view(storage),
+            collect_stats,
+            DataType::float32);
+}
+
+// Empty FlatNav inner-product graph whose vectors are `storage` (an IndexFlatIP).
+inline std::unique_ptr<FlatNavIP> make_flatnav_ip(
+        const faiss::IndexFlat& storage,
+        int M,
+        size_t max_nodes = 0,
+        bool collect_stats = false) {
+    FAISS_THROW_IF_NOT_MSG(
+            storage.metric_type == faiss::METRIC_INNER_PRODUCT,
+            "make_flatnav_ip: storage must be an IndexFlatIP");
+    FAISS_THROW_IF_NOT_MSG(storage.ntotal > 0, "storage is empty: add vectors first");
+    return std::make_unique<FlatNavIP>(
+            IPDistance::create(storage.d),
+            static_cast<int>(max_nodes ? max_nodes : storage.ntotal),
+            M,
+            storage_view(storage),
+            collect_stats,
+            DataType::float32);
+}
+
+// Call after storage.add() (buffer may have moved) or after
+// FlatNavL2::loadIndex() of a graph saved in shared-storage mode.
+template <class FlatNavIndex>
+inline void reattach(FlatNavIndex& index, const faiss::IndexFlat& storage) {
+    index.attachExternalStorage(storage_view(storage));
+}
+
+// Build the graph over storage rows not yet in the graph.
+// num_threads = FlatNav's own std::thread workers (independent of OpenMP).
+template <class FlatNavIndex>
+inline void build(
+        FlatNavIndex& index,
+        int ef_construction,
+        int num_threads = 1,
+        int num_initializations = 100) {
+    index.setNumThreads(static_cast<uint32_t>(std::max(1, num_threads)));
+    size_t todo = std::min(index.externalStorageNumVectors(), index.maxNodeCount()) -
+            index.currentNumNodes();
+    index.addFromStorage(todo, ef_construction, num_initializations);
+}
+
+// Faiss-style batched search: fills D/I as (nq x k), -1 padded.
+// Uses FlatNav's thread pool (index.getNumThreads()) unless num_threads > 0.
+template <class FlatNavIndex>
+inline void search(
+        FlatNavIndex& index,
+        faiss::idx_t nq,
+        const float* xq,
+        int k,
+        int ef_search,
+        float* D,
+        faiss::idx_t* I,
+        int num_threads = 0,
+        int num_initializations = 100) {
+    const size_t d = index.dataDimension();
+    auto one = [&](uint32_t q) {
+        auto res = index.search(xq + static_cast<size_t>(q) * d, k, ef_search, num_initializations);
+        const size_t row = static_cast<size_t>(q) * static_cast<size_t>(k);
+        for (int j = 0; j < k; j++) {
+            bool have = j < static_cast<int>(res.size());
+            D[row + j] = have ? res[j].first : -1.0f;
+            I[row + j] = have ? static_cast<faiss::idx_t>(res[j].second) : -1;
+        }
+    };
+    uint32_t threads = num_threads > 0 ? static_cast<uint32_t>(num_threads) : index.getNumThreads();
+    if (threads <= 1) {
+        for (faiss::idx_t q = 0; q < nq; q++) {
+            one(static_cast<uint32_t>(q));
+        }
+        return;
+    }
+    flatnav::executeInParallel(0, static_cast<uint32_t>(nq), threads, one);
+}
+
+// Bytes FlatNav itself allocated for node blocks (graph only in shared mode,
+// vectors + graph in owned mode).
+template <class FlatNavIndex>
+inline uint64_t graph_bytes(const FlatNavIndex& index) {
+    return index.getTotalIndexMemory();
+}
+
+// Vector bytes held inside FlatNav's own memory (0 when shared).
+template <class FlatNavIndex>
+inline uint64_t vector_bytes(const FlatNavIndex& index) {
+    return index.usesExternalStorage()
+            ? 0
+            : static_cast<uint64_t>(index.maxNodeCount()) * index.dataSizeBytes();
+}
+
+// Graph-only bytes (M links + label per node), comparable across the
+// shared and owned layouts and with hnsw/nsg_graph_bytes_direct().
+template <class FlatNavIndex>
+inline uint64_t graph_overhead_bytes(const FlatNavIndex& index) {
+    return index.getTotalIndexMemory() - vector_bytes(index);
+}
+
+// ------------------------------------------------------------
+// Separate (owned) storage: the regular FlatNav index that keeps its
+// own copy of the vectors in its interleaved [vector][links][label]
+// node layout. Used by the *_separate_storage_* demos.
+// ------------------------------------------------------------
+inline std::unique_ptr<FlatNavL2> make_flatnav_l2_owned(
+        int d,
+        size_t max_nodes,
+        int M,
+        bool collect_stats = false) {
+    return std::make_unique<FlatNavL2>(
+            L2Distance::create(d),
+            static_cast<int>(max_nodes),
+            M,
+            collect_stats,
+            DataType::float32);
+}
+
+inline std::unique_ptr<FlatNavIP> make_flatnav_ip_owned(
+        int d,
+        size_t max_nodes,
+        int M,
+        bool collect_stats = false) {
+    return std::make_unique<FlatNavIP>(
+            IPDistance::create(d),
+            static_cast<int>(max_nodes),
+            M,
+            collect_stats,
+            DataType::float32);
+}
+
+// Copies x (n x d, row-major) into the owned index and builds the graph.
+// Labels are 0..n-1, i.e. the same ids faiss assigns to the same rows.
+template <class FlatNavIndex>
+inline void build_owned(
+        FlatNavIndex& index,
+        const float* x,
+        size_t n,
+        int ef_construction,
+        int num_threads = 1,
+        int num_initializations = 100) {
+    if (index.usesExternalStorage()) {
+        throw std::logic_error("build_owned(): index uses shared storage; use build()");
+    }
+    std::vector<int> labels(n);
+    std::iota(labels.begin(), labels.end(), 0);
+    index.setNumThreads(static_cast<uint32_t>(std::max(1, num_threads)));
+    index.template addBatch<float>(
+            const_cast<float*>(x), labels, ef_construction, num_initializations);
+}
