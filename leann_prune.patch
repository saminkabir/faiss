+// Tests for the LEANN-style high-degree preserving graph pruning
+// (IndexHNSW::prune_leann and IndexNSG::prune_leann).
+
+#include <gtest/gtest.h>
+
+#include <omp.h>
+
+#include <algorithm>
+#include <cmath>
+#include <random>
+#include <set>
+#include <stack>
